{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.{js,css,woff2,woff,ttf,eot,svg,png,jpg,jpeg,gif,webp,ico}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/{login,register,logs,mfa-enroll,mfa-challenge,complete-profile}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/{tabs,listing,meetup,communities,buying,selling,inbox}/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/controlpanel",
        "destination": "https://firmshake-controlpanel.web.app/",
        "type": 301
      },
      {
        "source": "/controlpanel/:path*",
        "destination": "https://firmshake-controlpanel.web.app/:path",
        "type": 301
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}

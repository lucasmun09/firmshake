# =============================================================================
# DEVO / BETA — copy to .env.local for local dev and deovo CI secrets
# =============================================================================
# Firebase project: firmshake-dev
# Hosting URLs:    https://firmshake-dev.web.app  |  https://firmshake-dev.firebaseapp.com
# API:             staging Cloud Run (us-central1) — default below
# Data:            your existing test listings/users live here (keep using this stack for beta)
#
# =============================================================================
# PROD — copy to .env.production.local or GitHub Environment `prod` secrets
# =============================================================================
# Firebase project: firmshake-prod (separate empty Firestore — see docs/devo-prod-stacks.md)
# Hosting URLs:    https://firm-shake.com  |  https://www.firm-shake.com  (after DNS cutover)
# API:             prod Cloud Run (us-east1) — see .env.production.example
# Data:            clean slate; do NOT point prod at firmshake-dev
#
# Today firm-shake.com may still serve firmshake-dev (same data as beta). That is expected
# until you create firmshake-prod and cut DNS/Hosting over. See docs/devo-prod-stacks.md.

# Optional explicit stack override (`devo` | `prod`). When unset, inferred from
# VITE_FIREBASE_PROJECT_ID (firmshake-dev → deovo, firmshake-prod → prod) or
# Vite DEV → deovo. Controls the deovo debug banner + log auto-persist.
# VITE_APP_STACK=devo

# Firebase (from Firebase Console → Project settings → Web app)
# Devo/beta: firmshake-dev | Prod: firmshake-prod
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push (Firebase Console → Project settings → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Flask API — use tunnel URL when testing on a physical device.
# In local dev, leave as-is; Vite proxies /api and /health to this server so the
# browser only talks to localhost:5173 (avoids macOS cross-app permission prompts).
# Local / deovo: Vite proxies /api and /health to localhost:5001 (see vite.config.ts),
# or point at staging Cloud Run (no trailing slash).
# Prod: separate Cloud Run URL (us-east1) — see .env.production.example.
VITE_API_BASE_URL=https://firmshake-api-staging-858269838319.us-central1.run.app
# Local-only override example: VITE_API_BASE_URL=http://localhost:5001

# Meetup deposits / Stripe — default enabled when unset (devo). Set false on prod.
# VITE_PAYMENTS_ENABLED=true
# Alias: VITE_STRIPE_PAYMENTS_ENABLED=false

# Listing BFF — when true, create/update/remove go through firmshake-api (/api/v1/listings).
# Default: enabled in local dev when API is configured; set true for staging/production rollout.
# VITE_USE_BFF_LISTINGS=true

# Messages BFF — when true, send message via firmshake-api (`POST /api/v1/listings/{id}/messages`).
# Default: false (Firestore writes remain canonical until explicitly enabled in production).
# VITE_USE_BFF_MESSAGES=true

# Agreements BFF — when true, FirmShake mutations go through firmshake-api (/api/v1/agreements).
# Default: enabled in local dev when API is configured; set true for staging/production rollout.
# VITE_USE_BFF_AGREEMENTS=true

# Inbox BFF — when true, inbox thread fetch and read/archive go through firmshake-api (/api/v1/inbox).
# Default: false (Firestore listeners and direct inboxState writes remain canonical).
# VITE_USE_BFF_INBOX=true

# Users BFF — when true, profile updates, blocks, communities, and moderation go through
# firmshake-api (/api/v1/users, /api/v1/communities). Default: enabled in local dev when API is configured.
# VITE_USE_BFF_USERS=true

# Browse BFF — when true, browse search and categories go through firmshake-api
# (`POST /api/v1/browse/search`, `GET /api/v1/categories`). Default: enabled when API is configured.
# VITE_USE_BFF_BROWSE=true

# Google Maps — Places Autocomplete for meetup addresses
# In Google Cloud Console for this key, enable:
#   - Maps JavaScript API
#   - Places API (New)
#   - Geocoding API (for "Use my current location")
# Turn on billing and restrict the key to HTTP referrers, e.g.:
#   http://localhost:5173/*  https://firmshake-dev.web.app/*  https://firmshake-dev.firebaseapp.com/*
VITE_GOOGLE_MAPS_API_KEY=

# Google Sign-In — OPTIONAL in-page GIS button (FedCM). Not required for login.
# Default path is Firebase same-tab redirect via loginWithGoogle (no client ID needed).
# See docs/google-sign-in-ux.md for full checklist.
#
# WHAT YOU NEED TO DO (consoles — agent cannot do this):
# 1. Firebase Console → Authentication → Sign-in method → enable Google
# 2. Firebase Console → Authentication → Settings → Authorized domains:
#      localhost, {projectId}.web.app, firm-shake.com, www.firm-shake.com
# 3. Google Cloud Console → Credentials → Web client (auto created by Google Service)
#    → Authorized redirect URIs (paste all that apply to your project):
#      https://{projectId}.firebaseapp.com/__/auth/handler
#      https://{projectId}.web.app/__/auth/handler
#      https://firm-shake.com/__/auth/handler
#      https://www.firm-shake.com/__/auth/handler
# 4. Verify: sign in on each origin; on failure open /logs → auth → expectedRedirectUri
# 5. Redeploy hosting only if you change VITE_* values — OAuth console edits need no deploy
#
# Optional GIS only — Firebase Console → Google → Web client ID:
VITE_GOOGLE_WEB_CLIENT_ID=

# reCAPTCHA v3 — login protection (requires a reachable API for /api/auth/verify-recaptcha)
# Optional in local dev if unset; when set, use staging URL above or run firmshake-api locally.
# Create a v3 site key at https://console.cloud.google.com/security/recaptcha
# Add domains: localhost, firmshake-dev.web.app, firmshake-dev.firebaseapp.com
# Prod: firm-shake.com, www.firm-shake.com, firmshake-prod.web.app (separate site key).
# Production builds use reCAPTCHA Enterprise (matches firmshake-api Cloud Run verification).
VITE_RECAPTCHA_SITE_KEY=
# Set to false only when using classic reCAPTCHA + RECAPTCHA_SECRET_KEY on the API locally.
VITE_RECAPTCHA_USE_ENTERPRISE=

# Cypress E2E — optional; loaded from .env.local when running npm run test:e2e*
# Prefer MFA-enrolled credentials so authenticated smoke specs can sign in.
# CYPRESS_BASE_URL=https://firmshake-dev.web.app
# CYPRESS_TEST_EMAIL_MFA=
# CYPRESS_TEST_PASSWORD_MFA=
# CYPRESS_TEST_EMAIL=
# CYPRESS_TEST_PASSWORD=
# CYPRESS_SUPER_ADMIN_EMAIL=
# CYPRESS_SUPER_ADMIN_PASSWORD=

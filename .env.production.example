# Prod shape for Vite production builds (firmshake-prod).
# Copy to GitHub Environment `prod` secrets — do not commit real values.
# Local prod builds: create `.env.production.local` from this template (gitignored).
# See docs/devo-prod-stacks.md.

# Explicit stack (optional). Prefer firmshake-prod project id; set to fail-closed
# if you want to guarantee the deovo debug banner never appears.
VITE_APP_STACK=prod

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=firmshake-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=firmshake-prod
VITE_FIREBASE_STORAGE_BUCKET=firmshake-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Prod Cloud Run (us-east1) — set after service exists
VITE_API_BASE_URL=https://REPLACE-ME-firmshake-api-XXXX.us-east1.run.app

VITE_PAYMENTS_ENABLED=false
# VITE_STRIPE_PAYMENTS_ENABLED=false

VITE_USE_BFF_LISTINGS=true
VITE_USE_BFF_AGREEMENTS=true
VITE_USE_BFF_USERS=true
VITE_USE_BFF_MESSAGES=false
VITE_USE_BFF_INBOX=false
VITE_USE_BFF_BROWSE=true

VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_USE_ENTERPRISE=true

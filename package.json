{
  "name": "firmshake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "bash start.sh",
    "build": "vue-tsc && vite build",
    "build:devo": "vue-tsc && vite build --mode devo",
    "build:native": "npm run build:devo && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:smoke": "cypress run --spec tests/e2e/specs/auth.smoke.cy.ts,tests/e2e/specs/guest.routes.cy.ts,tests/e2e/specs/stack.devo.cy.ts,tests/e2e/specs/auth.login.cy.ts,tests/e2e/specs/auth.register.cy.ts,tests/e2e/specs/mfa.cy.ts,tests/e2e/specs/browse.filter.cy.ts,tests/e2e/specs/listing.upload.cy.ts,tests/e2e/specs/listing.detail.cy.ts,tests/e2e/specs/messages.cy.ts,tests/e2e/specs/communities.cy.ts,tests/e2e/specs/selling.cy.ts,tests/e2e/specs/buying.cy.ts,tests/e2e/specs/meetups.cy.ts,tests/e2e/specs/profile.cy.ts,tests/e2e/specs/settings.navigation.cy.ts",
    "test:integration": "npm run test:e2e:smoke",
    "test:unit": "vitest",
    "test:unit:marketplace": "vitest --run tests/unit/integration",
    "test:e2e:marketplace": "cypress run --spec tests/e2e/specs/marketplace.guest.cy.ts,tests/e2e/specs/marketplace.flow.cy.ts",
    "test:unit:dual-stack": "vitest --run tests/unit/appStack.spec.ts tests/unit/stackHosts.spec.ts tests/unit/paymentsFlag.spec.ts tests/unit/paymentsDisabledUx.spec.ts tests/unit/assertBakedStack.spec.ts tests/unit/dualStackEnvContracts.spec.ts tests/unit/checkProdReadiness.spec.ts tests/unit/dualStackCrossRepo.spec.ts tests/unit/dualStackCorsCatalog.spec.ts tests/unit/preflightHosting.spec.ts tests/unit/apiHealth.spec.ts tests/unit/apiHealthContract.spec.ts",
    "lint": "eslint .",
    "firebase:setup": "bash scripts/setup-firebase.sh",
    "firebase:setup:prod": "bash scripts/setup-firebase-prod.sh",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules --project devo",
    "firebase:deploy-rules:devo": "firebase deploy --only firestore:rules --project devo",
    "firebase:deploy-rules:prod": "firebase deploy --only firestore:rules --project prod",
    "deploy:hosting": "npm run deploy:hosting:devo",
    "deploy:hosting:devo": "bash scripts/deploy-devo-hosting.sh",
    "deploy:hosting:prod": "bash scripts/deploy-prod-hosting.sh",
    "deploy:prod": "bash scripts/deploy-prod-hosting.sh",
    "assert:stack:devo": "bash scripts/assert-baked-stack.sh deovo dist",
    "assert:stack:prod": "bash scripts/assert-baked-stack.sh prod dist",
    "check:prod-readiness": "bash scripts/check-prod-readiness.sh",
    "preflight:hosting:devo": "bash scripts/preflight-hosting.sh deovo",
    "preflight:hosting:prod": "bash scripts/preflight-hosting.sh prod",
    "firebase:seed": "node scripts/seed-communities.mjs",
    "firebase:backfill-feeds": "node scripts/backfill-listing-feeds.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.0",
    "@capacitor/app": "8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.0",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/push-notifications": "^8.0.2",
    "@capacitor/status-bar": "8.0.2",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "firebase": "^12.14.0",
    "ionicons": "^7.0.0",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.0",
    "@types/google.maps": "^3.65.1",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "cypress": "^13.5.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "firebase-admin": "^13.10.0",
    "jsdom": "^22.1.0",
    "terser": "^5.4.0",
    "typescript": "~5.9.0",
    "vite": "^5.0.0",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10"
  },
  "description": "FirmShake — community marketplace with binding meetups"
}

# Vite mode `devo` (npm run build:devo / deploy:hosting:devo).
# Loaded with .env + .env.local — does NOT load .env.production*.
# Keeps deovo Hosting on firmshake-dev even when .env.production.local exists locally.
VITE_APP_STACK=devo
# Mock deposit UX is fine on deovo (no Stripe). Prod builds must set false via
# .env.production.example / Environment `prod` — see docs/devo-prod-stacks.md.
# VITE_PAYMENTS_ENABLED=true
